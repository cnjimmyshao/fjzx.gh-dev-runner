# Runner deployment configuration only.
# Copy to .env on the execution machine. Do not commit the real .env.
# This file does not store GitHub or model credentials.

# Runner identity used by the @<runnerName> Trigger Contract.
RUNNER_NAME=MB01

# GitHub routing examples.
# Authentication is managed by the local gh login of the execution account.
GITHUB_ALLOWED_USERS=example-user
GITHUB_REPOSITORIES=owner/repo-a,owner/repo-b

# Local workspaces.
WORK_ROOT=/path/to/workspaces

# Harness location / persistence.
# DSH_HOME owns Harness credentials, profiles, sessions and other Harness state.
# DSH_BIN is a deployment example; the implementation must use the launcher
# supported by the actually installed Harness version.
DSH_BIN=/path/to/harness-entry
DSH_HOME=/path/to/dsh-home

# Scheduling configuration belongs to the Scheduling Contract.
# Exact field names/defaults are intentionally not fixed by Issue #20.
# POLL_INTERVAL_SECONDS=...
# MAX_HARNESS_PROCESSES=...
# MAX_HARNESS_PROCESSES_PER_REPO=...
