# Runner deployment configuration only.
# Copy to .env on the execution machine. Do not commit the real .env.
# This file does not store GitHub or model credentials.
# The Runner reads exactly the keys below; other environment variables are not
# treated as Runner configuration.

# Runner identity used by the @<runnerName> Trigger Contract.
# COORDINATOR is reserved for the Coordinator channel and cannot be used here.
RUNNER_NAME=MB01

# Repository routing must preserve repo -> allowedActors association; the value
# is a JSON array with one object per repository.
#   repo                     "owner/name"
#   allowedActors            GitHub logins allowed to trigger this Runner
#   sourceDir                existing checkout used as the worktree source
#   baseBranch               worktree start point (default: main)
#   worktreeDir              per-task worktree parent (default: WORK_ROOT/<owner__name>)
#   maxConcurrentHarnesses   repo-level limit (default: 1)
REPOSITORIES_JSON=[{"repo":"owner/repo-a","allowedActors":["alice"],"sourceDir":"/src/repo-a","baseBranch":"main","maxConcurrentHarnesses":1}]

# Local paths. STATE_DIR holds state.json, runner.lock, audit/ and runs/.
WORK_ROOT=/path/to/workspaces
STATE_DIR=/path/to/runner-state

# Harness location / persistence. DSH_BIN is the dsh launcher entry
# (for example <npx-cache>/node_modules/@deepseek-ai/dsh/lib/bin.js); an entry
# ending in .js/.mjs/.cjs is started with the Runner's own Node process.
# DSH_HOME owns Harness credentials, profiles, sessions and Harness state; if
# omitted, the Harness default home applies (for example ~/.dsh).
DSH_BIN=/path/to/harness-entry
DSH_PROFILE=headless
# DSH_HOME=/path/to/dsh-home

# Model credentials stay with the Harness. Only the variables listed here are
# passed through unchanged from the Runner process to the Harness child; the
# full process environment is never forwarded. Leave empty unless the installed
# Harness version requires environment credentials.
# HARNESS_ENV_ALLOWLIST=

# Scheduling semantics/defaults are defined by docs/current/05-harness-scheduling.md.
# POLL_SECONDS=300
# MAX_CONCURRENT_HARNESSES=1

# Local call timeout in milliseconds; 0 (default) means no hard timeout, so a
# long-running Dev round is not killed. Set it only when a stuck call must be
# bounded.
# HARNESS_TIMEOUT_MS=0

# GitHub CLI call parameters.
# GH_TIMEOUT_MS=60000
# GH_PAGE_SIZE=50
# GH_MAX_PAGES=10

# Run capture / retention. `metadata` (default) keeps only technical events
# (session, status, final-presence, error) and never keeps model text; `full`
# also keeps the raw event stream and stderr. KEEP_RUN_LOGS (>= 1) bounds how
# many run directories are retained; directories of runs that still occupy a
# slot are never removed.
# CAPTURE=metadata
# KEEP_RUN_LOGS=20

# Optional git executable override (for example when PATH resolves to a broken
# git build).
# GIT_BIN=/opt/homebrew/bin/git
