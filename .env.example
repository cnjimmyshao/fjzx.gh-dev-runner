# Runner deployment configuration only.
# Copy to .env on the execution machine. Do not commit the real .env.
# This file does not store GitHub or model credentials.

# Runner identity used by the @<runnerName> Trigger Contract.
RUNNER_NAME=MB01

# Repository routing must preserve repo -> allowedActors association.
# The concrete parser/encoding may evolve with implementation; do not split
# repositories and actors into unrelated global lists.
# Example conceptual value:
# REPOSITORIES_JSON=[{"repo":"owner/repo-a","allowedActors":["alice"],"sourceDir":"/src/repo-a","maxConcurrentHarnesses":1},{"repo":"owner/repo-b","allowedActors":["bob"],"sourceDir":"/src/repo-b","maxConcurrentHarnesses":1}]

# Local paths.
WORK_ROOT=/path/to/workspaces
STATE_DIR=/path/to/runner-state

# Harness location / persistence.
# DSH_HOME owns Harness credentials, profiles, sessions and Harness state.
DSH_BIN=/path/to/harness-entry
# Optional override. If omitted, keep the Harness default home (for example ~/.dsh).
# DSH_HOME=/path/to/dsh-home

# Scheduling semantics/defaults are defined by docs/current/05-harness-scheduling.md.
# POLL_SECONDS=300
# MAX_CONCURRENT_HARNESSES=1
