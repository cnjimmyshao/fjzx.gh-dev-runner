# Runner deployment configuration only.
# Copy to .env on the execution machine. Do not commit the real .env.

# Runner identity used by the @<runnerName> Trigger Contract.
RUNNER_NAME=MB01

# Polling / concurrency example values.
# Scheduling Contract owns their final semantics/defaults.
POLL_INTERVAL_SECONDS=60
# Keep global concurrency at 1 until the configured Harness version passes shared-DSH_HOME concurrency validation.
MAX_HARNESS_PROCESSES=1
MAX_HARNESS_PROCESSES_PER_REPO=1

# GitHub routing
# GitHub authentication is NOT stored here. Runner startup requires a working local `gh auth status`,
# and Harness reuses the same execution account's local gh authentication.
GITHUB_ALLOWED_USERS=example-user
GITHUB_REPOSITORIES=owner/repo-a,owner/repo-b

# Local workspaces
WORK_ROOT=/path/to/workspaces

# Harness location.
# DSH_BIN points to the JS entry used by the currently verified launcher path.
# Harness credentials, profiles and sessions belong under DSH_HOME itself,
# not in this Runner .env.
DSH_BIN=/path/to/node_modules/@deepseek-ai/dsh/lib/bin.js
DSH_HOME=/path/to/dsh-home
